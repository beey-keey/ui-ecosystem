{
  "name": "ui-ecosystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable UI ecosystem and integration architecture based on Vue 3 and TypeScript",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=task-management-chromium --project=inventory-management-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "type-check": "pnpm -r --if-present run type-check && pnpm type-check:e2e",
    "type-check:e2e": "tsc --project tsconfig.e2e.json",
    "validate": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "validate:full": "pnpm validate && pnpm test:e2e",
    "quality-gate": "pnpm validate",
    "quality-gate:full": "pnpm validate:full",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:oxlint": "oxlint apps packages e2e",
    "lint:eslint": "eslint apps packages e2e",
    "lint:fix": "oxlint apps packages e2e --fix && eslint apps packages e2e --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "oxlint": "~1.82.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue": "^3.5.46",
    "vue-eslint-parser": "^10.4.2"
  }
}
